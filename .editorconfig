root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{lua,sh}]
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[*.pdf]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
